# --- Client (Vite) — safe to expose ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server (Vercel functions) — keep secret ---
# Get a free key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Verified sender domain in Resend (for production).
# For testing you may use: LilMed Quotes <onboarding@resend.dev>
QUOTE_FROM_EMAIL=LilMed Quotes <onboarding@resend.dev>
QUOTE_TO_EMAIL=info@lilmed.co.za

# Optional: Supabase service key for admin operations (never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
